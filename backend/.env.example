# =======================
# 🗄️  DATABASE
# =======================
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# =======================
# 🔄 REDIS (BullMQ Queue)
# =======================
# Option A: Full URL (preferred for cloud Redis like Upstash)
REDIS_URL=rediss://default:password@your-redis-host:6379
# Option B: Host + Port (for local Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# =======================
# 📧 EMAIL (Resend)
# =======================
RESEND_API_KEY=re_xxxx_xxxxxxxxxxxx
EMAIL_FROM="onboarding@resend.dev"
EMAIL_SENDER_NAME="Cold Mail House"

# Resend Configuration (Free Plan Limitation)
# On basics/free plan, you can only send to this email address.
RESEND_ALLOWED_TEST_EMAIL=you@gmail.com

# =======================
# 🤖 AI (Google Gemini)
# =======================
GEMINI_API_KEY=

# =======================
# 🌐 APP
# =======================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# =======================
# 🔐 SESSION
# =======================
SESSION_SECRET=change_this_to_a_long_random_string_in_production
